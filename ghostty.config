# Ghostty config for Roasty — copy to ~/.config/ghostty/config
# Requires: JetBrainsMono Nerd Font (brew install --cask font-jetbrains-mono-nerd-font)

font-family = JetBrainsMono Nerd Font
font-size = 13
theme = Citruszest
window-decoration = true
macos-titlebar-style = tabs
window-padding-x = 8
window-padding-y = 8

# Split management
keybind = cmd+d=new_split:right
keybind = cmd+shift+d=new_split:down
keybind = cmd+shift+f=toggle_split_zoom

# Split navigation (Vim-style)
keybind = cmd+h=goto_split:left
keybind = cmd+l=goto_split:right
keybind = cmd+k=goto_split:top
keybind = cmd+j=goto_split:bottom

# Mouse and Clipboard
copy-on-select = clipboard
clipboard-read = allow
clipboard-paste-protection = false

# Modern UI Touches
cursor-style-blink = true
scrollback-limit = 100000
